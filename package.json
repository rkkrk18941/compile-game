{
  "name": "compile-game",
  "private": true,
  "description": "Static game collection. NOCLIP is built from noclip/src with `npm run build:noclip`; 東京そらさんぽ from tokyo-sora/src with `npm run build:tokyo-sora`; The・Island from island/src with `npm run build:island` (assets from island/blender/*.py, then `npm run optimize:island`).",
  "scripts": {
    "build:noclip": "node tools/build-noclip.mjs",
    "build:tokyo-sora": "node tools/build-tokyo-sora.mjs",
    "build:island": "node tools/build-island.mjs",
    "optimize:island": "node tools/optimize-island.mjs",
    "build:kyoju": "node tools/build-kyoju.mjs",
    "test:kyoju": "node tools/test-kyoju.mjs"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@mapbox/vector-tile": "^2.0.5",
    "earcut": "^3.2.4",
    "esbuild": "0.28.2",
    "leaflet": "^1.9.4",
    "meshoptimizer": "^1.3.0",
    "pbf": "^4.0.2",
    "peerjs": "1.5.5",
    "three": "0.186.0"
  }
}
