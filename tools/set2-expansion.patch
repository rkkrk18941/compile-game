+<script id="set2-expansion-ui">
+/* ==== expansion set selector / final integration ==== */
+'use strict';
+(()=>{
+  const previousLoadSave=loadSave;
+  loadSave=function(){const game=previousLoadSave.apply(this,arguments);if(game&&!game.cardSet)game.cardSet='set1';return game;};
+  function selectedSet(){
+    const saved=typeof loadSave==='function'?loadSave():null;
+    const stored=(()=>{try{return localStorage.getItem('compile-card-set');}catch(e){return null;}})();
+    return normalizeCardSet(saved?.cardSet||stored||draft?.cardSet||'set1');
+  }
+  function setSelectedSet(mode){
+    mode=normalizeCardSet(mode);draft.cardSet=mode;
+    try{localStorage.setItem('compile-card-set',mode);}catch(e){}
+    document.querySelectorAll('[data-card-set]').forEach(button=>button.classList.toggle('on',button.dataset.cardSet===mode));
+    const note=document.getElementById('cardSetNote');if(note)note.textContent=mode==='mixed'?'第1・第2セットの全24プロトコルからドラフトします。':`${CARD_SET_LABELS[mode]}の12プロトコルからドラフトします。`;
+    return mode;
+  }
+  function installSetSelector(){
+    const form=document.querySelector('#setupBox .setupform');if(!form||document.getElementById('cardSetSetting'))return;
+    const current=selectedSet();draft.cardSet=current;
+    const box=document.createElement('div');box.className='setupoption cardsetoption';box.id='cardSetSetting';
+    box.innerHTML=`<span>使用カードセット</span><div class="setupseg cardsetseg">
+      <button type="button" data-card-set="set1">第1セット</button>
+      <button type="button" data-card-set="set2">第2セット</button>
+      <button type="button" data-card-set="mixed">混合</button>
+    </div><small id="cardSetNote"></small>`;
+    const control=document.getElementById('controlSetting');form.insertBefore(box,control||null);
+    box.querySelectorAll('[data-card-set]').forEach(button=>button.onclick=()=>setSelectedSet(button.dataset.cardSet));
+    setSelectedSet(current);
+    const desc=document.querySelector('#setupBox .ttldesc');
+    if(desc)desc.innerHTML='使用するカードセットを選び、各プレイヤーが3プロトコルずつドラフト。<br>先に自分の3プロトコルすべてをコンパイルせよ。<br><span style="color:#8890a8">自分のライン合計が10以上かつ相手より高ければコンパイル。</span>';
+  }
+  const previousWelcome=renderWelcome;
+  renderWelcome=function(){const result=previousWelcome.apply(this,arguments);installSetSelector();return result;};
+
+  const previousFinish=finishSetup;
+  finishSetup=function(){draft.cardSet=selectedSet();const result=previousFinish.apply(this,arguments);if(G){G.cardSet=draft.cardSet;log(`カードセット：${CARD_SET_LABELS[G.cardSet]}`);stableState=true;autosave(true);}return result;};
+
+  if(typeof netLobby==='function'){
+    const previousLobby=netLobby;
+    netLobby=function(){const result=previousLobby.apply(this,arguments);const desc=document.querySelector('#setupBox .ttldesc');if(desc&&!desc.querySelector('.net-card-set'))desc.insertAdjacentHTML('beforeend',`<br><span class="net-card-set">カードセット: <b>${esc(CARD_SET_LABELS[normalizeCardSet(draft.cardSet)])}</b></span>`);return result;};
+  }
+
+  const previousPrompt=promptPlayCard;
+  promptPlayCard=async function(player,card,opts={}){
+    const before=fieldLocation(card),result=await previousPrompt.apply(this,arguments);const after=fieldLocation(card);
+    if(result&&!before&&after)await set2TriggerAfterCardPlayed(player,after.player,after.line,card);
+    return result;
+  };
+
+  const style=document.createElement('style');style.id='set2-expansion-style';style.textContent=`
+.cardsetoption{grid-column:1/-1}.cardsetseg{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr));width:100%;gap:5px}
+.cardsetseg button{min-width:0;padding:8px 5px!important;font-size:10px!important}.cardsetoption small{display:block;margin-top:7px;line-height:1.5}
+@media(max-width:520px){.cardsetseg{grid-template-columns:1fr}.cardsetseg button{padding:7px!important}}
+`;
+  if(!document.getElementById(style.id))document.head.appendChild(style);
+  globalThis.COMPILE_CARD_SETS=Object.freeze({set1:[...SET1_PROTOCOLS],set2:[...SET2_PROTOCOLS],mixed:[...SET1_PROTOCOLS,...SET2_PROTOCOLS],get:()=>normalizeCardSet(draft.cardSet),set:setSelectedSet});
+  if(document.querySelector('#setup:not(.hidden)'))renderWelcome();
+})();
+</script>
